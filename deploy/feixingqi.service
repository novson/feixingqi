[Unit]
Description=Online Flying Chess (feixingqi)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=feixingqi
Group=feixingqi
WorkingDirectory=/opt/feixingqi/server
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=18090
Environment=FLY_ALLOWED_ORIGINS=http://139.224.254.109
Environment=FLY_WEB_DIST=/opt/feixingqi/web/dist
Environment=FLY_ACCOUNTS_FILE=/var/lib/feixingqi/accounts.json
Environment=FLY_TURN_SECONDS=25
Environment=FLY_AWAY_SECONDS=5
Environment=FLY_AI_THINK_MS=900
ExecStart=/usr/bin/node /opt/feixingqi/server/src/index.js
# 崩溃、被杀、异常退出都自动拉起（Restart=always 覆盖 SIGKILL / 非零退出 / 干净退出）
Restart=always
RestartSec=3
TimeoutStopSec=30
SuccessExitStatus=143
MemoryMax=512M
SyslogIdentifier=feixingqi
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
StateDirectory=feixingqi

[Install]
WantedBy=multi-user.target
